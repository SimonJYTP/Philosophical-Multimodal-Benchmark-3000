{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PHILBENCH-3000 per-item prediction record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "run_id",
    "family",
    "prompt_id",
    "condition",
    "language",
    "max_output_tokens",
    "prediction",
    "raw_response",
    "parse_status",
    "refusal",
    "api_failure",
    "latency_ms",
    "retry_count",
    "timestamp_utc"
  ],
  "properties": {
    "id": {"type": "string", "pattern": "^PHILBENCH-3000-[0-9]{4}$"},
    "run_id": {"type": "string", "minLength": 1},
    "family": {"type": "string", "minLength": 1},
    "prompt_id": {"type": "string", "minLength": 1},
    "condition": {"enum": ["correct_image", "context_removed", "text_only", "shuffled_image", "hl_gold_context", "text_only_native"]},
    "language": {"enum": ["en", "zh"]},
    "max_output_tokens": {"type": "integer", "minimum": 1},
    "prediction": {"type": "string"},
    "raw_response": {"type": ["string", "object", "null"]},
    "parse_status": {"enum": ["strict_ok", "lenient_only", "failed"]},
    "parse_error": {"type": ["string", "null"]},
    "refusal": {"type": "boolean"},
    "api_failure": {"type": "boolean"},
    "failure_type": {"type": ["string", "null"]},
    "latency_ms": {"type": "number", "minimum": 0},
    "input_tokens": {"type": ["integer", "null"], "minimum": 0},
    "output_tokens": {"type": ["integer", "null"], "minimum": 0},
    "cost_usd": {"type": ["number", "null"], "minimum": 0},
    "retry_count": {"type": "integer", "minimum": 0},
    "provider_request_id": {"type": ["string", "null"]},
    "image_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "image_width": {"type": ["integer", "null"], "minimum": 1},
    "image_height": {"type": ["integer", "null"], "minimum": 1},
    "timestamp_utc": {"type": "string", "format": "date-time"}
  }
}
